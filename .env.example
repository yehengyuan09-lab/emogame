# EmoGame 环境变量配置
# 复制为 .env 并填入实际值

# OpenAI API (LLM 报告生成)
OPENAI_API_KEY=sk-xxx

# 数据库 (开发环境默认使用 SQLite)
DATABASE_URL=sqlite:///data/emogame.db

# Redis (缓存 + 消息队列)
REDIS_URL=redis://localhost:6379

# VLM 模型目录 (本地模型存放路径)
VLM_MODEL_DIR=/models

# 百度指数 API (可选)
BAIDU_INDEX_API_KEY=

# Bilibili API (可选)
BILIBILI_API_KEY=

# 日志级别
LOG_LEVEL=INFO
